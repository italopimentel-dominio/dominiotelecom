# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# Chave secreta (service_role / secret). NUNCA colocar com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# Opcional: domínio usado para gerar o e-mail interno de quem não tem e-mail
LOGIN_EMAIL_DOMAIN=metas.local
# Segredo combinado com o Apps Script do Formulário Google (invente um texto longo)
FORMS_WEBHOOK_SECRET=troque-por-um-texto-longo-e-aleatorio
